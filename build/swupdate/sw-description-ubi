software =
{
    version = "1.1.0";
    description = "Firmware update for Tina5 T113s4 Board";

    stable = {

        /* upgrade recovery,uboot,boot0 ==> change swu_mode,boot_partition ==> reboot */
        upgrade_recovery = {
            /* upgrade recovery */
            images: (
                {
                    filename = "recovery";
		    		volume = "recovery"
                    installed-directly = true;
                },
                {
                    filename = "uboot";
                    type = "awuboot";
                },
                {
                    filename = "boot0";
                    type = "awboot0";
                }
            );
            /* change swu_mode to upgrade_kernel,boot_partition to recovery & reboot*/
            bootenv: (
                {
                    name = "swu_mode";
                    value = "upgrade_kernel";
                },
                {
                    name = "boot_partition";
                    value = "recovery";
                },
                {
                    name = "bootcmd";
                    value = "run setargs_nand_ubi boot_recovery";
                },
                {
                    name = "setargs_nand_ubi";
                    value = "setenv  bootargs  partitions=${partitions} ubi.mtd=${mtd_name} ubi.block=0,${root_partition} earlycon=${earlycon} clk_ignore_unused initcall_debug=${initcall_debug} console=${console} loglevel=${loglevel} init=${init} ";
                },                
                {
                    name = "swu_next";
                    value = "reboot";
                }
            );
        };

        /* upgrade kernel,rootfs ==> change sw_mode */
        upgrade_kernel = {
            /* upgrade kernel,rootfs */
            images: (
                {
                    filename = "kernel";
		    volume = "boot"
                    installed-directly = true;
                },
                {
                    filename = "rootfs";
		    volume = "rootfs"
                    installed-directly = true;
                }
            );
            /* change sw_mode to upgrade_usr,change boot_partition to boot */
            bootenv: (
                {
                    name = "swu_mode";
                    value = "upgrade_usr";
                },
                {
                    name = "boot_partition";
                    value = "boot";
                },
                {
                    name = "bootcmd";
                    value = "run setargs_nand_ubi boot_normal";
                },
                {
                    name = "setargs_nand_ubi";
		    value = "setenv bootargs partitions=${partitions} ubi.mtd=${mtd_name} ubi.block=0,${root_partition} earlyprintk=${earlyprintk} clk_ignore_unused initcall_debug=${initcall_debug} console=${console} loglevel=${loglevel} root=${nand_root} rootfstype=${rootfstype} init=${init} rdinit=${rdinit} cma=${cma} snum=${snum} mac_addr=${mac} wifi_mac=${wifi_mac} bt_mac=${bt_mac} specialstr=${specialstr} gpt=1";
                }                
            );
        };

        /* upgrade usr ==> clean ==> reboot */
        upgrade_usr = {
            /* upgrade usr */

            /* clean swu_param,swu_software,swu_mode & reboot */
            bootenv: (
                {
                    name = "swu_param";
                    value = "";
                },
                {
                    name = "swu_software";
                    value = "";
                },
                {
                    name = "swu_mode";
                    value = "";
                },
                {
                    name = "swu_next";
                    value = "reboot";
                }
            );
        };

    };

    /* when not call with -e xxx,xxx    just clean */
    bootenv: (
        {
            name = "swu_param";
            value = "";
        },
        {
            name = "swu_software";
            value = "";
        },
        {
            name = "swu_mode";
            value = "";
        },
        {
            name = "swu_version";
            value = "";
        }
    );

}
